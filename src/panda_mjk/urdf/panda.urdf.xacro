<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fer">
  <!-- Arguments -->
  <xacro:arg name="use_sim" default="true"/>
  <xacro:arg name="robot_ip" default="192.168.1.100"/>

  <!-- arm_id is "fer" (Franka Emika Research), franka_description's current identifier
       for the real Franka Emika Panda robot. "fr3" is a different, newer physical robot
       (different kinematics/dynamics/link geometry); do not use it here, it would
       load the wrong joint limits/kinematics/inertials for this robot.

       no_prefix=false (the franka_description default): links/joints are named
       "fer_link0", "fer_joint1", etc. This is required for compatibility with
       franka_example_controllers, whose interface names are hardcoded as
       "<arm_prefix><robot_type>_jointN" (there is no way to get an unprefixed
       "jointN" out of that format) and with real Franka hardware, which always
       uses arm_id-prefixed names. The MuJoCo side (panda.xml) keeps its own
       unprefixed "jointN" names from mujoco_menagerie; our hardware plugin and
       the ros2_control <joint> blocks below bridge the two naming schemes.

       hand=false: we don't need franka_robot.xacro's hand-attachment code here.
       MuJoCo renders the real gripper mesh directly from panda.xml, and the real
       hardware gripper is driven separately by the franka_gripper node, not
       through this ros2_control/URDF path; only the finger_joint1 interface
       below (for MuJoCo sim) is needed. -->
  <xacro:include filename="$(find franka_description)/robots/common/franka_robot.xacro"/>
  <xacro:franka_robot arm_id="fer"
                      joint_limits="${xacro.load_yaml('$(find franka_description)/robots/fer/joint_limits.yaml')}"
                      kinematics="${xacro.load_yaml('$(find franka_description)/robots/fer/kinematics.yaml')}"
                      inertials="${xacro.load_yaml('$(find franka_description)/robots/fer/inertials.yaml')}"
                      dynamics="${xacro.load_yaml('$(find franka_description)/robots/fer/dynamics.yaml')}"
                      gazebo="false"
                      hand="false"
                      tcp_xyz="0 0 0.1034"
                      tcp_rpy="0 0 0"
                      no_prefix="false" />

  <!-- ros2_control definition -->
  <ros2_control name="FrankaSystem" type="system">
    <hardware>
      <xacro:if value="$(arg use_sim)">
        <!-- MuJoCo Simulator Plugin with Franka Parity -->
        <plugin>panda_mjk_hardware/MujocoFrankaSystemInterface</plugin>
        <!-- The path must point to the MJCF file we copied from mujoco_menagerie -->
        <param name="mujoco_model">$(find panda_mjk)/urdf/panda.xml</param>
        <!-- The arm joints only have pure-torque MuJoCo actuators (see panda.xml), so
             position/velocity command modes need mujoco_ros2_control's own PID to drive
             them; these gains reproduce the position-hold behavior the old built-in
             MuJoCo position actuators had. -->
        <param name="pids_config_file">$(find panda_mjk)/config/mujoco_pids.yaml</param>
      </xacro:if>

      <xacro:unless value="$(arg use_sim)">
        <!-- Real Franka Hardware Plugin -->
        <plugin>franka_hardware/FrankaHardwareInterface</plugin>
        <param name="robot_ip">$(arg robot_ip)</param>
      </xacro:unless>
    </hardware>

    <!-- Define Interfaces for all 7 arm joints. Names match the "fer_jointN" links/joints
         franka_robot.xacro just generated above (franka_example_controllers and real
         hardware both expect this naming); our hardware plugin maps these to MuJoCo's
         unprefixed "jointN" actuators internally. -->
    <xacro:macro name="configure_joint" params="joint_name">
      <joint name="${joint_name}">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>

    <xacro:configure_joint joint_name="fer_joint1"/>
    <xacro:configure_joint joint_name="fer_joint2"/>
    <xacro:configure_joint joint_name="fer_joint3"/>
    <xacro:configure_joint joint_name="fer_joint4"/>
    <xacro:configure_joint joint_name="fer_joint5"/>
    <xacro:configure_joint joint_name="fer_joint6"/>
    <xacro:configure_joint joint_name="fer_joint7"/>

    <!-- Gripper joint definition (Only finger_joint1 is needed as control interface, finger_joint2 is mimicked/coupled) -->
    <joint name="finger_joint1">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <!-- On real hardware, franka_hardware exposes nothing for gripper. On sim, mujoco_ros2_control can. -->
    <!-- F/T Sensor for Gravity Compensation -->
    <sensor name="fer_tcp">
      <state_interface name="force.x" />
      <state_interface name="force.y" />
      <state_interface name="force.z" />
      <state_interface name="torque.x" />
      <state_interface name="torque.y" />
      <state_interface name="torque.z" />
    </sensor>

    <!-- GPIO interfaces for Franka specific data -->
    <gpio name="fer">
      <state_interface name="robot_model" />
      <state_interface name="robot_state" />
      <state_interface name="robot_time" />
    </gpio>

    <!-- Custom GPIO for Cartesian poses and velocities (dummy block for 1-15 omitted for brevity, you would ideally macro this or declare them all) -->
    <!-- Assuming the plugin dynamically exports these anyway, adding one here as an example if validation requires it -->
    <gpio name="fer0">
      <state_interface name="cartesian_pose_state" />
      <command_interface name="cartesian_pose_command" />
    </gpio>
    <gpio name="fervx">
      <command_interface name="cartesian_velocity" />
    </gpio>

    <!-- Elbow interfaces for nullspace control (Cartesian + elbow controllers) -->
    <gpio name="joint_3_position">
      <state_interface name="elbow_state" />
      <command_interface name="elbow_command" />
    </gpio>
    <gpio name="joint_4_sign">
      <state_interface name="elbow_state" />
      <command_interface name="elbow_command" />
    </gpio>
  </ros2_control>
</robot>
